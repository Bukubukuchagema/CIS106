<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M2P4"/>
        <attribute name="authors" value="Kyle"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-25 02:49:48 AM"/>
        <attribute name="created" value="S3lsZTtERVNLVE9QLTRUVlU5TU47MjAyNi0wNS0yNTswMjo0MzoxMCBBTTsyNzY4"/>
        <attribute name="edited" value="S3lsZTtERVNLVE9QLTRUVlU5TU47MjAyNi0wNS0yNTswMjo0OTo0OCBBTTsxOzI4OTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="LastName" type="String" array="False" size=""/>
            <declare name="CreditsTaken" type="Real" array="False" size=""/>
            <declare name="Tuition" type="Real" array="False" size=""/>
            <input variable="LastName"/>
            <input variable="CreditsTaken"/>
            <assign variable="Tuition" expression="250 * CreditsTaken + 100"/>
            <output expression="&quot;Last Name: &quot; &amp; (LastName)" newline="True"/>
            <output expression="&quot;Total Tuition: &quot; &amp; (Tuition)" newline="True"/>
        </body>
    </function>
</flowgorithm>
