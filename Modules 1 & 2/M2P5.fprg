<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M2P5"/>
        <attribute name="authors" value="Kyle"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-25 03:01:51 AM"/>
        <attribute name="created" value="S3lsZTtERVNLVE9QLTRUVlU5TU47MjAyNi0wNS0yNTswMjo0OTo1NSBBTTsyNzgz"/>
        <attribute name="edited" value="S3lsZTtERVNLVE9QLTRUVlU5TU47MjAyNi0wNS0yNTswMzowMTo1MSBBTTsxOzI4NzY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Price" type="Real" array="False" size=""/>
            <declare name="PercentOff" type="Real" array="False" size=""/>
            <declare name="DiscountTotal" type="Real" array="False" size=""/>
            <declare name="DiscountPrice" type="Real" array="False" size=""/>
            <input variable="Price"/>
            <output expression="&quot;Please enter the discount as a decimal (Ex. 0.15 for 15%):&quot;" newline="True"/>
            <input variable="PercentOff"/>
            <assign variable="DiscountTotal" expression="Price * PercentOff"/>
            <assign variable="DiscountPrice" expression="Price - DiscountTotal"/>
            <output expression="&quot;Discount Amount: &quot; &amp; (DiscountTotal)" newline="True"/>
            <output expression="&quot;Discounted Price: &quot; &amp; (DiscountPrice)" newline="True"/>
        </body>
    </function>
</flowgorithm>
